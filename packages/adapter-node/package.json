{
  "name": "@jornjp/adapter-node",
  "version": "0.1.0",
  "description": "jev-argos adapter for Node.js BFFs: gRPC interceptors that report security signals to the jev-argos control server",
  "keywords": [
    "jev-argos",
    "security",
    "grpc",
    "interceptor",
    "bff",
    "express",
    "fastify",
    "nextjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jornJp0201/jev-argos.git",
    "directory": "packages/adapter-node"
  },
  "homepage": "https://github.com/jornJp0201/jev-argos/tree/main/packages/adapter-node#readme",
  "bugs": {
    "url": "https://github.com/jornJp0201/jev-argos/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "proto"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/copy-proto.mjs && tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/copy-proto.mjs && tsc -b && node --test \"dist/test/**/*.test.js\"",
    "clean": "rm -rf dist proto *.tsbuildinfo",
    "prepublishOnly": "node scripts/copy-proto.mjs && tsc -b && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
