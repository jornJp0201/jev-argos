{
  "name": "@jev-argos/adapter-node",
  "version": "0.1.0",
  "description": "jev-argos adapter for Node.js BFFs: gRPC interceptors that report security signals to the jev-argos control server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "proto"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/copy-proto.mjs && tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/copy-proto.mjs && tsc -b && node --test \"dist/test/**/*.test.js\"",
    "clean": "rm -rf dist proto *.tsbuildinfo"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.2",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
